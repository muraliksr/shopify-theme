{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-banner-slider-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    display: block;
    overflow: hidden;
  }

  .ai-banner-slider__track-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.5s ease-in-out;
  }

  .ai-banner-slider__slide-{{ ai_gen_id }} {
    min-width: 100%;
    position: relative;
  }

  .ai-banner-slider__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: auto;
  }

  .ai-banner-slider__desktop-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    height: auto;
  }

  .ai-banner-slider__mobile-{{ ai_gen_id }} {
    display: none;
    width: 100%;
    height: auto;
  }

  .ai-banner-slider__placeholder-{{ ai_gen_id }} {
    background-color: #f4f4f4;
    width: 100%;
    min-height: 400px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-banner-slider__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 600px;
    max-height: 400px;
  }

  .ai-banner-slider__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-banner-slider__content-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    color: {{ block.settings.text_color }};
    width: 90%;
    max-width: 800px;
    z-index: 2;
  }

  .ai-banner-slider__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 16px;
    color: {{ block.settings.heading_color }};
  }

  .ai-banner-slider__subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    margin: 0 0 24px;
    color: {{ block.settings.subheading_color }};
  }

  .ai-banner-slider__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  .ai-banner-slider__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
  }

  .ai-banner-slider__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    z-index: 1;
  }

  .ai-banner-slider__dots-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 10px;
    z-index: 3;
  }

  .ai-banner-slider__dot-{{ ai_gen_id }} {
    width: {{ block.settings.dot_size }}px;
    height: {{ block.settings.dot_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    opacity: 0.5;
    cursor: pointer;
    border: none;
    padding: 0;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .ai-banner-slider__dot-{{ ai_gen_id }}:hover {
    opacity: 0.8;
    transform: scale(1.1);
  }

  .ai-banner-slider__dot-{{ ai_gen_id }}.active {
    opacity: 1;
    background-color: {{ block.settings.dot_active_color }};
  }

  .ai-banner-slider__arrows-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    transform: translateY(-50%);
    display: flex;
    justify-content: space-between;
    pointer-events: none;
    z-index: 3;
    padding: 0 20px;
  }

  .ai-banner-slider__arrow-{{ ai_gen_id }} {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: {{ block.settings.arrow_background }};
    color: {{ block.settings.arrow_color }};
    border: none;
    cursor: pointer;
    pointer-events: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.3s ease;
  }

  .ai-banner-slider__arrow-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.arrow_hover_background }};
  }

  .ai-banner-slider__arrow-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
  }

  @media screen and (max-width: 749px) {
    .ai-banner-slider__desktop-{{ ai_gen_id }} {
      display: none;
    }

    .ai-banner-slider__mobile-{{ ai_gen_id }} {
      display: block;
    }

    .ai-banner-slider__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.6 }}px;
    }

    .ai-banner-slider__subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.8 }}px;
    }

    .ai-banner-slider__placeholder-{{ ai_gen_id }} {
      min-height: 300px;
    }

    .ai-banner-slider__arrows-{{ ai_gen_id }} {
      padding: 0 10px;
    }

    .ai-banner-slider__arrow-{{ ai_gen_id }} {
      width: 32px;
      height: 32px;
    }

    .ai-banner-slider__arrow-{{ ai_gen_id }} svg {
      width: 16px;
      height: 16px;
    }
  }
{% endstyle %}

<banner-slider-{{ ai_gen_id }}
  class="ai-banner-slider-{{ ai_gen_id }}"
  data-autoplay="{{ block.settings.enable_autoplay }}"
  data-autoplay-speed="{{ block.settings.autoplay_speed }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-banner-slider__track-{{ ai_gen_id }}">
    {% for i in (1..5) %}
      {% liquid
        assign desktop_image_key = 'slide_' | append: i | append: '_desktop_image'
        assign mobile_image_key = 'slide_' | append: i | append: '_mobile_image'
        assign heading_key = 'slide_' | append: i | append: '_heading'
        assign subheading_key = 'slide_' | append: i | append: '_subheading'
        assign button_text_key = 'slide_' | append: i | append: '_button_text'
        assign button_link_key = 'slide_' | append: i | append: '_button_link'

        assign desktop_image = block.settings[desktop_image_key]
        assign mobile_image = block.settings[mobile_image_key]
        assign heading = block.settings[heading_key]
        assign subheading = block.settings[subheading_key]
        assign button_text = block.settings[button_text_key]
        assign button_link = block.settings[button_link_key]
      %}

      {% if desktop_image or mobile_image %}
        <div class="ai-banner-slider__slide-{{ ai_gen_id }}" data-slide="{{ i }}">
          <div class="ai-banner-slider__image-wrapper-{{ ai_gen_id }}">
            {% if desktop_image %}
              <img
                src="{{ desktop_image | image_url: width: 2000 }}"
                alt="{{ desktop_image.alt | escape }}"
                loading="lazy"
                width="{{ desktop_image.width }}"
                height="{{ desktop_image.height }}"
                class="ai-banner-slider__desktop-{{ ai_gen_id }}"
              >
            {% endif %}

            {% if mobile_image %}
              <img
                src="{{ mobile_image | image_url: width: 1000 }}"
                alt="{{ mobile_image.alt | escape }}"
                loading="lazy"
                width="{{ mobile_image.width }}"
                height="{{ mobile_image.height }}"
                class="ai-banner-slider__mobile-{{ ai_gen_id }}"
              >
            {% elsif desktop_image %}
              <img
                src="{{ desktop_image | image_url: width: 1000 }}"
                alt="{{ desktop_image.alt | escape }}"
                loading="lazy"
                width="{{ desktop_image.width }}"
                height="{{ desktop_image.height }}"
                class="ai-banner-slider__mobile-{{ ai_gen_id }}"
              >
            {% endif %}

            {% if block.settings.show_overlay %}
              <div class="ai-banner-slider__overlay-{{ ai_gen_id }}"></div>
            {% endif %}

            {% if block.settings.show_content %}
              <div class="ai-banner-slider__content-{{ ai_gen_id }}">
                {% if heading != blank %}
                  <h2 class="ai-banner-slider__heading-{{ ai_gen_id }}">{{ heading }}</h2>
                {% endif %}

                {% if subheading != blank %}
                  <p class="ai-banner-slider__subheading-{{ ai_gen_id }}">{{ subheading }}</p>
                {% endif %}

                {% if button_text != blank and button_link != blank %}
                  <a
                    href="{{ button_link }}"
                    class="ai-banner-slider__button-{{ ai_gen_id }}"
                  >
                    {{ button_text }}
                  </a>
                {% endif %}
              </div>
            {% endif %}
          </div>
        </div>
      {% endif %}
    {% endfor %}

    {% unless block.settings.slide_1_desktop_image or block.settings.slide_1_mobile_image %}
      <div class="ai-banner-slider__slide-{{ ai_gen_id }}">
        <div class="ai-banner-slider__placeholder-{{ ai_gen_id }}">
          {{ 'hero-apparel-1' | placeholder_svg_tag }}
          <div class="ai-banner-slider__empty-state-{{ ai_gen_id }}">
            Add images to create slides
          </div>
        </div>
      </div>
    {% endunless %}
  </div>

  {% if block.settings.show_dots %}
    <div class="ai-banner-slider__dots-{{ ai_gen_id }}"></div>
  {% endif %}

  {% if block.settings.show_arrows %}
    <div class="ai-banner-slider__arrows-{{ ai_gen_id }}">
      <button class="ai-banner-slider__arrow-{{ ai_gen_id }} ai-banner-slider__arrow-prev-{{ ai_gen_id }}" aria-label="Previous slide">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>
      <button class="ai-banner-slider__arrow-{{ ai_gen_id }} ai-banner-slider__arrow-next-{{ ai_gen_id }}" aria-label="Next slide">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>
  {% endif %}
</banner-slider-{{ ai_gen_id }}>

<script>
  (function() {
    class BannerSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.autoplayInterval = null;
      }

      connectedCallback() {
        this.style.display = 'block';
        this.track = this.querySelector('.ai-banner-slider__track-{{ ai_gen_id }}');
        this.slides = this.querySelectorAll('.ai-banner-slider__slide-{{ ai_gen_id }}');
        this.dotsContainer = this.querySelector('.ai-banner-slider__dots-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.ai-banner-slider__arrow-prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.ai-banner-slider__arrow-next-{{ ai_gen_id }}');
        
        this.autoplay = this.dataset.autoplay === 'true';
        this.autoplaySpeed = parseInt(this.dataset.autoplaySpeed) || 5000;

        if (this.slides.length > 0) {
          this.init();
        }
      }

      init() {
        this.createDots();
        this.attachEventListeners();
        
        if (this.autoplay) {
          this.startAutoplay();
        }
      }

      createDots() {
        if (!this.dotsContainer) return;

        this.dotsContainer.innerHTML = '';
        this.slides.forEach((slide, index) => {
          const dot = document.createElement('button');
          dot.classList.add('ai-banner-slider__dot-{{ ai_gen_id }}');
          if (index === 0) {
            dot.classList.add('active');
          }
          dot.setAttribute('aria-label', 'Go to slide ' + (index + 1));
          dot.addEventListener('click', () => this.goToSlide(index));
          this.dotsContainer.appendChild(dot);
        });
      }

      attachEventListeners() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => this.prevSlide());
        }

        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => this.nextSlide());
        }

        this.addEventListener('mouseenter', () => this.pauseAutoplay());
        this.addEventListener('mouseleave', () => {
          if (this.autoplay) {
            this.startAutoplay();
          }
        });
      }

      goToSlide(index) {
        this.currentSlide = index;
        this.updateSlider();
      }

      nextSlide() {
        this.currentSlide = (this.currentSlide + 1) % this.slides.length;
        this.updateSlider();
      }

      prevSlide() {
        this.currentSlide = (this.currentSlide - 1 + this.slides.length) % this.slides.length;
        this.updateSlider();
      }

      updateSlider() {
        const offset = -this.currentSlide * 100;
        this.track.style.transform = 'translateX(' + offset + '%)';

        if (this.dotsContainer) {
          const dots = this.dotsContainer.querySelectorAll('.ai-banner-slider__dot-{{ ai_gen_id }}');
          dots.forEach((dot, index) => {
            if (index === this.currentSlide) {
              dot.classList.add('active');
            } else {
              dot.classList.remove('active');
            }
          });
        }

        if (this.autoplay) {
          this.resetAutoplay();
        }
      }

      startAutoplay() {
        this.autoplayInterval = setInterval(() => {
          this.nextSlide();
        }, this.autoplaySpeed);
      }

      pauseAutoplay() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
          this.autoplayInterval = null;
        }
      }

      resetAutoplay() {
        this.pauseAutoplay();
        this.startAutoplay();
      }

      disconnectedCallback() {
        this.pauseAutoplay();
      }
    }

    customElements.define('banner-slider-{{ ai_gen_id }}', BannerSlider{{ ai_gen_id }});
  })();
</script>

